{
  "name": "quote-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "dev": "vite",
    "build": "npm run prebuild && vue-tsc --noEmit && vite build",
    "build:single": "npm run prebuild && vite build --mode single && node scripts/fix-file-protocol.mjs",
    "build:all": "npm run prebuild && npm run build && npm run build:single",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "proxy": "node server/proxy.mjs"
  },
  "dependencies": {
    "@rollup/plugin-babel": "^6.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.2.6",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "agent-base": "^9.0.0",
    "autoprefixer": "^10.4.20",
    "http-proxy-agent": "^9.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
